# Waveshare requires ESP-IDF 5.5 or newer for this board.
# The refresh log formats a dozen-odd arguments, several of them building
# temporary Strings on this stack, and at 8192 it overflowed the moment one
# more field was added. The headroom is cheaper than rediscovering that.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# The board's Type-C connector is wired to the ESP32-S3 native USB port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Allow the Rust application to scale the CPU from 160 MHz down to the 40 MHz
# crystal while idle. Automatic light sleep stays off so USB remains responsive.
CONFIG_PM_ENABLE=y

# Tickless idle is a prerequisite for the light sleep callbacks, and on its own
# only lets the idle task skip ticks; `light_sleep_enable` still gates any real
# sleep. The callbacks are what let the dashboard's eco badge report sleep that
# actually happened rather than sleep that was merely configured.
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y

# The ESP32-S3 cannot keep USB Serial/JTAG alive across light sleep, so ESP-IDF
# holds an ESP_PM_NO_LIGHT_SLEEP lock for exactly as long as a host is
# connected. `power::source` calls `usb_serial_jtag_is_connected`, which is what
# links the connection monitor that maintains it.
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y

# Powering the CPU down through light sleep requires every driver in the build
# to be sleep-retention aware, which the panel SPI, I2C, and ADC drivers here
# are not known to be. Sleeping with the CPU powered gives up a little current
# for a much smaller blast radius.
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=n

# Synchronize system time shortly after boot, then only once per day. The
# battery-backed RTC is updated from each successful synchronization.
CONFIG_LWIP_SNTP_UPDATE_DELAY=86400000

# A newly installed OTA image gets one boot to prove that the application can
# initialize and render. Until it confirms that state, a reboot rolls back to
# the previous slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ESP32-S3-PICO-1-N8R8 has 8 MB embedded flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
