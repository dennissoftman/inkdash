# Waveshare requires ESP-IDF 5.5 or newer for this board.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# The board's Type-C connector is wired to the ESP32-S3 native USB port.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Allow the Rust application to scale the CPU from 160 MHz down to the 40 MHz
# crystal while idle. Automatic light sleep stays off so USB remains responsive.
CONFIG_PM_ENABLE=y

# A newly installed OTA image gets one boot to prove that the application can
# initialize and render. Until it confirms that state, a reboot rolls back to
# the previous slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ESP32-S3-PICO-1-N8R8 has 8 MB embedded flash.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
